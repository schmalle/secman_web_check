# Copy to .env for local use. Do not place credentials in configuration files.
SECMAN_WEB_CHECK_CONCURRENCY=4
SECMAN_WEB_CHECK_ACTIVE=false
SECMAN_WEB_CHECK_ALLOW_PRIVATE_TARGETS=false
